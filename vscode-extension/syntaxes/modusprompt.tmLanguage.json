{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ModusFlow Prompt",
  "scopeName": "source.modusprompt",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#case_statements"
    },
    {
      "include": "#loops"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#macros"
    },
    {
      "include": "#filters"
    },
    {
      "include": "#loras"
    },
    {
      "include": "#hexcolors"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#curators"
    },
    {
      "include": "#wildcards"
    },
    {
      "include": "#shuffles"
    },
    {
      "include": "#dynamic_choices"
    },
    {
      "include": "#weights"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.modusprompt",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.number-sign.modusprompt",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.modusprompt",
          "match": "//.*$"
        }
      ]
    },
    "loras": {
      "patterns": [
        {
          "name": "entity.name.tag.lora.modusprompt",
          "match": "(<lora:)([a-zA-Z0-9_.-]+)(?::([+-]?[0-9]*\\.?[0-9]+))?(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.modusprompt" },
            "2": { "name": "variable.parameter.lora-name.modusprompt" },
            "3": { "name": "constant.numeric.lora-weight.modusprompt" },
            "4": { "name": "punctuation.definition.tag.end.modusprompt" }
          }
        }
      ]
    },
    "hexcolors": {
      "patterns": [
        {
          "name": "constant.other.color.hex.modusprompt",
          "match": "#[0-9a-fA-F]{6}\\b|#[0-9a-fA-F]{3}\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.assignment.modusprompt",
          "match": "(\\$[a-zA-Z0-9_]+)\\s*(=)\\s*([^;]+)(;)",
          "captures": {
            "1": { "name": "variable.name.modusprompt" },
            "2": { "name": "keyword.operator.assignment.modusprompt" },
            "3": { "name": "string.unquoted.variable-value.modusprompt" },
            "4": { "name": "punctuation.terminator.modusprompt" }
          }
        },
        {
          "name": "variable.other.reference.modusprompt",
          "match": "\\$[a-zA-Z0-9_]+"
        }
      ]
    },
    "curators": {
      "patterns": [
        {
          "name": "support.variable.curator.modusprompt",
          "match": "\\{(curator\\d*|list|item)\\}"
        }
      ]
    },
    "wildcards": {
      "patterns": [
        {
          "name": "string.interpolated.wildcard.modusprompt",
          "match": "(__)([a-zA-Z0-9_/.-]+)(__)",
          "captures": {
            "1": { "name": "punctuation.definition.wildcard.begin.modusprompt" },
            "2": { "name": "entity.name.function.wildcard.modusprompt" },
            "3": { "name": "punctuation.definition.wildcard.end.modusprompt" }
          }
        }
      ]
    },
    "shuffles": {
      "patterns": [
        {
          "name": "keyword.control.shuffle.modusprompt",
          "begin": "\\{(shuffle:)",
          "beginCaptures": {
            "1": { "name": "keyword.other.shuffle.modusprompt" }
          },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#hexcolors" },
            { "include": "#wildcards" },
            { "include": "#weights" }
          ]
        }
      ]
    },
    "dynamic_choices": {
      "patterns": [
        {
          "name": "meta.dynamic-choice.modusprompt",
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.choice.begin.modusprompt" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.choice.end.modusprompt" }
          },
          "patterns": [
            {
              "name": "constant.numeric.pick-n.modusprompt",
              "match": "^\\s*(\\d+(?:-\\d+)?)\\$\\$"
            },
            {
              "name": "constant.numeric.weighted-odd.modusprompt",
              "match": "(\\d+)(::)"
            },
            {
              "name": "punctuation.separator.choice.modusprompt",
              "match": "\\|"
            },
            { "include": "#comments" },
            { "include": "#hexcolors" },
            { "include": "#wildcards" },
            { "include": "#variables" },
            { "include": "#weights" },
            { "include": "#dynamic_choices" }
          ]
        }
      ]
    },
    "weights": {
      "patterns": [
        {
          "name": "meta.attention-weight.modusprompt",
          "match": "(\\()([^():]+)(:)([+-]?[0-9]*\\.?[0-9]+)(\\))",
          "captures": {
            "1": { "name": "punctuation.section.weight.begin.modusprompt" },
            "2": { "name": "string.unquoted.weighted-tag.modusprompt" },
            "3": { "name": "punctuation.separator.weight.modusprompt" },
            "4": { "name": "constant.numeric.attention-weight.modusprompt" },
            "5": { "name": "punctuation.section.weight.end.modusprompt" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.modusprompt",
          "match": "\\b(case|switch|for|in|as|repeat|fn|def|return|default)\\b"
        },
        {
          "name": "keyword.control.import.modusprompt",
          "match": "@import\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.modusprompt",
          "match": "\\b(range|rand)\\s*\\("
        },
        {
          "name": "support.function.method.modusprompt",
          "match": "\\.(keys|values|length)\\b"
        },
        {
          "name": "entity.name.function.macro.modusprompt",
          "match": "(@[a-zA-Z0-9_]+)\\s*\\("
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "name": "entity.name.function.preset.modusprompt",
          "match": "!(cine|photo|anime|neg)\\b"
        }
      ]
    },
    "filters": {
      "patterns": [
        {
          "name": "support.function.pipe.modusprompt",
          "match": "(\\|)\\s*(upper|lower|title|trim|join)\\b",
          "captures": {
            "1": { "name": "keyword.operator.pipe.modusprompt" },
            "2": { "name": "support.function.filter.modusprompt" }
          }
        }
      ]
    },
    "case_statements": {
      "patterns": [
        {
          "name": "meta.case-statement.modusprompt",
          "begin": "(\\{)\\s*(case\\b)",
          "beginCaptures": {
            "1": { "name": "punctuation.section.block.begin.modusprompt" },
            "2": { "name": "keyword.control.case.modusprompt" }
          },
          "end": "(\\})",
          "endCaptures": {
            "1": { "name": "punctuation.section.block.end.modusprompt" }
          },
          "patterns": [
            { "name": "keyword.operator.arrow.modusprompt", "match": "=>" },
            { "name": "keyword.control.default.modusprompt", "match": "\\bdefault\\b" },
            { "name": "punctuation.separator.pipe.modusprompt", "match": "\\|" },
            { "name": "string.quoted.double.modusprompt", "begin": "\"", "end": "\"" },
            { "name": "string.quoted.single.modusprompt", "begin": "'", "end": "'" },
            { "include": "#variables" },
            { "include": "#loras" },
            { "include": "#wildcards" },
            { "include": "#comments" }
          ]
        }
      ]
    },
    "loops": {
      "patterns": [
        {
          "name": "meta.loop.repeat.modusprompt",
          "begin": "(\\{)\\s*(repeat\\b)",
          "beginCaptures": {
            "1": { "name": "punctuation.section.block.begin.modusprompt" },
            "2": { "name": "keyword.control.repeat.modusprompt" }
          },
          "end": "(\\})",
          "endCaptures": {
            "1": { "name": "punctuation.section.block.end.modusprompt" }
          },
          "patterns": [
            { "name": "keyword.operator.arrow.modusprompt", "match": "=>" },
            { "include": "#variables" },
            { "include": "#loras" },
            { "include": "#wildcards" },
            { "include": "#dynamic_choices" },
            { "include": "#comments" }
          ]
        },
        {
          "name": "meta.loop.for.modusprompt",
          "begin": "(\\{)\\s*(for\\b)",
          "beginCaptures": {
            "1": { "name": "punctuation.section.block.begin.modusprompt" },
            "2": { "name": "keyword.control.for.modusprompt" }
          },
          "end": "(\\})",
          "endCaptures": {
            "1": { "name": "punctuation.section.block.end.modusprompt" }
          },
          "patterns": [
            { "name": "keyword.control.in.modusprompt", "match": "\\bin\\b" },
            { "name": "keyword.operator.arrow.modusprompt", "match": "=>" },
            { "include": "#variables" },
            { "include": "#loras" },
            { "include": "#wildcards" },
            { "include": "#functions" },
            { "include": "#dynamic_choices" },
            { "include": "#comments" }
          ]
        }
      ]
    }
  }
}
